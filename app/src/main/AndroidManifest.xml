<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline only: strip network permissions even if a library's manifest asks for them. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Only for scanning a TOTP QR code; asked for when the scan button is pressed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Ẩn cửa sổ nổi của app khác trên màn hình của app (chống lừa bấm / tapjacking). Quyền thường, không hỏi. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Tự động điền: đọc chứng chỉ ký + tên của app đang xin điền, để chỉ điền đúng app thật (không app giả cùng
         tên gói). Không cho app đọc dữ liệu của app khác. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".MatKhauApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MatKhau"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|mcc|mnc|colorMode|grammaticalGender"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Giữ biểu tượng app → "Khóa ngay" -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Khóa khẩn cấp từ shortcut: không giao diện, khóa rồi đóng. Exported để launcher mở được;
             app khác gọi vào cũng chỉ làm vault khóa lại. -->
        <activity
            android:name=".LockActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Dịch vụ tự động điền. Chỉ hệ thống bind được (BIND_AUTOFILL_SERVICE). -->
        <service
            android:name=".autofill.MatKhauAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>

        <!-- Mở khóa / chọn mục / lưu cho tự động điền. Không exported: chỉ mở qua PendingIntent của chính app. -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|mcc|mnc|colorMode|grammaticalGender"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ô "Khóa Mật Khẩu" trong Cài đặt nhanh. Chỉ hệ thống bind được (BIND_QUICK_SETTINGS_TILE). -->
        <service
            android:name=".security.PanicLockTileService"
            android:exported="true"
            android:icon="@drawable/ic_lock_small"
            android:label="@string/tile_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
